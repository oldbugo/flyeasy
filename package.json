{
  "name": "flyeasy",
  "version": "1.0.1",
  "author": "FlyEasy",
  "description": "Local-first desktop travel-hunt app for Trip.com flight search and verification.",
  "private": true,
  "type": "module",
  "main": "src/desktop/main/main.mjs",
  "scripts": {
    "dev": "next dev",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "electron": "electron src/desktop/main/main.mjs",
    "build": "next build",
    "build:desktop": "npm run build",
    "prepare:desktop-runtime": "node scripts/pack/prepare-runtime.mjs",
    "rebuild:native": "npm rebuild better-sqlite3",
    "pack:win": "npm run prepare:desktop-runtime && npm run rebuild:native && npm run build:desktop && electron-builder --win nsis --dir",
    "dist:win": "npm run prepare:desktop-runtime && npm run rebuild:native && npm run build:desktop && electron-builder --win nsis --publish never",
    "start": "next start",
    "lint": "eslint . --ext .js,.mjs,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "next build && node --test --test-concurrency=2 \"tests/**/*.test.mjs\"",
    "test:app": "next build && node --test \"tests/app/**/*.test.mjs\"",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:browser": "node --test \"tests/browser/**/*.test.mjs\"",
    "test:worker": "node --test --test-concurrency=1 \"tests/worker/**/*.test.mjs\"",
    "db:generate": "node scripts/db-generate.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "proof:install-browser": "npx playwright install chromium",
    "proof:desktop": "node scripts/proofs/desktop-smoke.mjs",
    "proof:run-lifecycle": "node scripts/proofs/run-lifecycle-refresh.mjs",
    "proof:session-probe": "node scripts/proofs/session-probe.mjs",
    "proof:packaged-search": "node scripts/proofs/packaged-search-extraction.mjs",
    "proof:deep-verification": "node scripts/proofs/deep-verification-boundary.mjs",
    "proof:recovery-resume": "node scripts/proofs/recovery-resume.mjs",
    "proof:ui-workflow-sweep": "node scripts/proofs/ui-workflow-sweep.mjs",
    "locations:sync-tripcom": "node scripts/locations/sync-tripcom-location-catalog.mjs",
    "tripcom:check": "node scripts/automation/check-connection.mjs",
    "tripcom:baseline-run": "node scripts/automation/run-baseline-search.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "better-sqlite3": "^12.8.0",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.7",
    "playwright": "^1.55.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.14.10",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.19",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.3.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4"
  },
  "build": {
    "appId": "com.flyeasy.app",
    "artifactName": "FlyEasy-Setup-${version}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app-dist",
        "filter": [
          "**/*",
          "!artifacts{,/**/*}",
          "!designs{,/**/*}",
          "!docs{,/**/*}",
          "!release{,/**/*}",
          "!flyeasy.db",
          "!package-lock.json",
          "!README.md",
          "!tmp-*.log"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "app-dist/node_modules"
      },
      {
        "from": "node_modules/better-sqlite3",
        "to": "app-dist/node_modules/better-sqlite3"
      },
      {
        "from": "node_modules/bindings",
        "to": "app-dist/node_modules/bindings"
      },
      {
        "from": "node_modules/file-uri-to-path",
        "to": "app-dist/node_modules/file-uri-to-path"
      },
      {
        "from": ".next/static",
        "to": "app-dist/.next/static"
      },
      {
        "from": "node_modules/playwright",
        "to": "app-dist/node_modules/playwright"
      },
      {
        "from": "node_modules/playwright-core",
        "to": "app-dist/node_modules/playwright-core"
      },
      {
        "from": "scripts",
        "to": "app-dist/scripts"
      },
      {
        "from": "drizzle",
        "to": "app-dist/drizzle"
      },
      {
        "from": ".desktop-runtime/node",
        "to": "app-dist-runtime/node"
      }
    ],
    "files": [
      "package.json",
      "src/desktop/**/*",
      "!node_modules{,/**/*}"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false
    },
    "productName": "FlyEasy",
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    }
  },
  "overrides": {
    "yauzl": "^3.2.1"
  },
  "allowScripts": {
    "electron@41.10.7": true,
    "better-sqlite3@12.8.0": true
  }
}
